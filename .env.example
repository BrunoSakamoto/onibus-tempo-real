# Fonte das posições: rio (API da Prefeitura, sem cadastro), sptrans (precisa de token) ou gravacao
FONTE=rio
INTERVALO_SEGUNDOS=30

# Só para FONTE=sptrans: token criado em https://www.sptrans.com.br/desenvolvedores/
SPTRANS_TOKEN=

# Rodando fora do Docker (com o Kafka e o Postgres do docker compose):
# KAFKA_SERVIDORES=localhost:9094
# DATABASE_URL=postgresql://onibus:onibus@localhost:5432/onibus
